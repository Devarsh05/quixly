# App shell (Shopify React Router template) — local env template.
# Copy to `.env` and fill in. NEVER commit real values.
#
# For local development, `npm run dev` (shopify app dev) manages most of these
# for you via the Shopify CLI (API key/secret, app URL, tunneling). These are
# listed here for reference and for non-CLI / deployed environments.

# Shopify app credentials (from your Partners dashboard / `shopify app dev`)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL of the app (set automatically by the CLI tunnel in local dev)
SHOPIFY_APP_URL=

# Comma-separated Admin API access scopes (kept in sync via shopify.app.toml)
SCOPES=

# Session storage. Prisma owns ONLY the Session table, and only inside the `shopify`
# Postgres schema — Alembic (agent/) owns every other table, in `public`.
# See CLAUDE.md > "Schema ownership". Note the plain `postgresql://` scheme: the agent
# addresses this same database as `postgresql+asyncpg://`. One DB, two drivers, two schemas.
DATABASE_URL=postgresql://quixly:quixly@localhost:5432/quixly?schema=shopify
#
# DEPLOYED ENVIRONMENTS append Prisma pool parameters to the URL above (env only — there is
# no code change and no Prisma schema change; Prisma parses both off the connection string):
#
#   DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?schema=shopify&connection_limit=10&pool_timeout=3
#
# Why, precisely. CLAUDE.md > "Shopify token custody" records a KNOWN residual: the webhook
# refresh path is pool-coupled and can deadlock. The per-shop advisory lock holds one pooled
# connection for its whole $transaction, while `authenticate.webhook()` refreshes through the
# library's global client storage, which cannot be pinned to that transaction — so the lock
# winner needs a SECOND connection it may not be able to get. Prisma's default pool is
# `num_cpus * 2 + 1`, which on a small deployed container is ~5.
#   - connection_limit=10 raises the number of concurrent same-shop webhook refreshes needed
#     to reach the deadlock.
#   - pool_timeout=3 bounds the wait: a starved request FAILS FAST, inside Shopify's 5s
#     webhook budget, so Shopify retries the delivery instead of the request hanging until
#     Shopify times out and the connection is held even longer.
#
# THIS IS A MITIGATION, NOT THE FIX. It raises the threshold and bounds the blast radius; it
# does not remove the second-connection requirement. The actual fix (making the webhook
# refresh use the same tx-pinned connection as the admin-token path already does) is tracked
# in docs/backlog.md > Token custody and is a separate change.

# Internal app <-> agent API (see agent/.env.example).
# INTERNAL_API_KEY is a shared secret and must match agent/.env EXACTLY.
AGENT_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=
